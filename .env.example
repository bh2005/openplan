# Kopie als .env anlegen und anpassen (die .env wird nicht eingecheckt).
# Docker Compose liest sie automatisch.

# Administrator (wird beim ersten Start angelegt). Leer = Zufallspasswort im Log (docker compose logs openplan | grep Admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Port für den lokalen Betrieb (docker-compose.yml)
PORT=8083

# Optional: JWT-Secret (sonst automatisch in data/jwt_secret), Token-Laufzeit in Stunden
# JWT_SECRET=
# TOKEN_TTL_HOURS=12

# Optional: Active Directory (kann auch in der Verwaltung gepflegt werden; dort gespeicherte Werte haben Vorrang)
# LDAP_URL=ldaps://dc.corp.example:636
# LDAP_BASE_DN=DC=corp,DC=example
# LDAP_DOMAIN=corp.example
# LDAP_REQUIRED_GROUP=
# LDAP_ADMIN_GROUP=
# LDAP_AUDITOR_GROUP=

# Optional: API-Dokumentation (Swagger unter /docs, OpenAPI unter /openapi.json)
#   1 = offen (Standard) | admin = nur angemeldete Administratoren | 0 = aus
# API_DOCS=1
# Optional: Schnittstellen (Verwaltung → API-Zugänge / Webhooks)
# API_TOKEN_RATE=120                       # Anfragen je API-Token und Minute
# WEBHOOK_ALLOWED_HOSTS=corp.example       # Positivliste für Webhook-Ziele (Domains inkl. Subdomains), leer = alle öffentlichen/privaten
# WEBHOOK_ALLOW_HTTP=0                     # 1 erlaubt http:// als Webhook-Ziel (nur Tests)
